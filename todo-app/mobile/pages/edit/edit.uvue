<template>
  <view class="page">
    <!-- 自定义导航栏 -->
    <view class="nav" :style="{ paddingTop: statusBarHeight + 10 + 'px' }">
      <view class="nav-back" hover-class="nav-back-hover" @click="goBack">
        <text class="nav-back-text">‹</text>
      </view>
      <text class="nav-title">{{ isEdit ? '编辑任务' : '新增任务' }}</text>
      <view class="nav-placeholder"></view>
    </view>

    <view v-if="loading" class="loading-box">
      <view class="spinner"></view>
      <text class="loading-text">正在读取任务...</text>
    </view>

    <scroll-view v-else class="form-scroll" :scroll-y="true">
      <view class="form-body">
        <view class="form-hero">
          <text class="form-eyebrow">任务信息</text>
          <text class="form-title">{{ isEdit ? '编辑任务' : '新增任务' }}</text>
          <text class="form-sub">保存后会同步到后端，并让统计缓存失效</text>
        </view>

        <!-- 标题 -->
        <view class="field">
          <view class="field-head">
            <text class="field-label">任务标题</text>
            <text class="field-required">必填</text>
          </view>
          <input
            class="text-input"
            v-model="title"
            type="text"
            :maxlength="100"
            placeholder="例如：完成软工课程设计开题报告"
            placeholder-class="input-placeholder"
            :adjust-position="true"
          />
          <text class="char-count">{{ title.length }} / 100</text>
        </view>

        <!-- 优先级 -->
        <view class="field">
          <text class="field-label">优先级</text>
          <view class="priority-row">
            <view class="priority-option" :class="priority === 1 ? 'priority-option-low' : ''" @click="setPriority(1)">
              <text class="priority-option-text" :class="priority === 1 ? 'priority-text-low' : ''">低</text>
              <text class="priority-option-desc">可以稍后</text>
            </view>
            <view class="priority-option" :class="priority === 2 ? 'priority-option-mid' : ''" @click="setPriority(2)">
              <text class="priority-option-text" :class="priority === 2 ? 'priority-text-mid' : ''">中</text>
              <text class="priority-option-desc">正常推进</text>
            </view>
            <view class="priority-option" :class="priority === 3 ? 'priority-option-high' : ''" @click="setPriority(3)">
              <text class="priority-option-text" :class="priority === 3 ? 'priority-text-high' : ''">高</text>
              <text class="priority-option-desc">优先处理</text>
            </view>
          </view>
        </view>

        <!-- 截止日期 -->
        <view class="field">
          <view class="field-head">
            <text class="field-label">截止日期</text>
            <text v-if="dueDate.length > 0" class="field-clear" @click="clearDueDate">清除</text>
          </view>
          <picker mode="date" :value="pickerDate()" @change="onDateChange">
            <view class="picker-box">
              <text class="picker-icon">◷</text>
              <text class="picker-value" :class="dueDate.length === 0 ? 'picker-placeholder' : ''">
                {{ dueDate.length > 0 ? dueDate : '选择日期（可选）' }}
              </text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
        </view>

        <!-- 备注 -->
        <view class="field">
          <text class="field-label">备注</text>
          <textarea
            class="textarea"
            v-model="description"
            :maxlength="500"
            placeholder="补充说明、验收标准或注意事项（可选）"
            placeholder-class="input-placeholder"
            :adjust-position="true"
          />
          <text class="char-count">{{ description.length }} / 500</text>
        </view>

        <view class="tip-card">
          <text class="tip-title">数据流</text>
          <text class="tip-text">页面 → api/task.uts → uni.request → Spring Boot → MySQL / Redis</text>
        </view>
      </view>
    </scroll-view>

    <view class="bottom-bar">
      <view class="cancel-button" hover-class="cancel-button-hover" @click="goBack">
        <text class="cancel-button-text">取消</text>
      </view>
      <view class="save-button" hover-class="save-button-hover" @click="handleSave">
        <text class="save-button-text">{{ saving ? '保存中...' : '保存任务' }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { getTask, createTask, updateTask } from '../../api/task.uts'

const statusBarHeight = ref(0)
const taskId = ref(0)
const isEdit = ref(false)
const loading = ref(false)
const saving = ref(false)

const title = ref('')
const description = ref('')
const priority = ref(2)
const dueDate = ref('')

/**
 * 注意函数定义顺序：
 * UTS 编译到 Android 后是 Kotlin 局部函数，
 * 被调用的函数必须先定义，不能像 JS 那样依赖变量提升。
 */

function goBack() {
  uni.navigateBack({
    fail: () => {
      uni.reLaunch({
        url: '/pages/index/index'
      })
    }
  })
}

async function loadTask(id: number) {
  loading.value = true
  try {
    const task = await getTask(id)
    title.value = task.title
    description.value = task.description
    priority.value = task.priority
    dueDate.value = task.dueDate
  } catch (e) {
    uni.showToast({
      title: '任务不存在或已删除',
      icon: 'none'
    })
    setTimeout(() => {
      goBack()
    }, 600)
  } finally {
    loading.value = false
  }
}

function setPriority(value: number) {
  priority.value = value
}

function today(): string {
  const d = new Date()
  const year = d.getFullYear().toString()
  let month = (d.getMonth() + 1).toString()
  let day = d.getDate().toString()
  if (month.length < 2) {
    month = '0' + month
  }
  if (day.length < 2) {
    day = '0' + day
  }
  return year + '-' + month + '-' + day
}

function pickerDate(): string {
  if (dueDate.value.length > 0) {
    return dueDate.value
  }
  return today()
}

function onDateChange(event: UniPickerChangeEvent) {
  dueDate.value = event.detail.value as string
}

function clearDueDate() {
  dueDate.value = ''
}

function validate(): boolean {
  if (title.value.trim().length === 0) {
    uni.showToast({
      title: '请输入任务标题',
      icon: 'none'
    })
    return false
  }
  if (title.value.length > 100) {
    uni.showToast({
      title: '标题不能超过 100 个字符',
      icon: 'none'
    })
    return false
  }
  return true
}

async function handleSave() {
  if (saving.value || !validate()) {
    return
  }

  saving.value = true
  try {
    if (isEdit.value) {
      await updateTask(taskId.value, title.value.trim(), description.value.trim(), priority.value, dueDate.value)
      uni.showToast({
        title: '修改成功',
        icon: 'success'
      })
    } else {
      await createTask(title.value.trim(), description.value.trim(), priority.value, dueDate.value)
      uni.showToast({
        title: '新增成功',
        icon: 'success'
      })
    }
    setTimeout(() => {
      goBack()
    }, 500)
  } catch (e) {
    // 错误提示由 request.uts 统一处理
  } finally {
    saving.value = false
  }
}

onLoad((options: OnLoadOptions) => {
  const info = uni.getSystemInfoSync()
  statusBarHeight.value = info.statusBarHeight

  const rawId = options['id']
  if (rawId != null) {
    const parsed = parseInt(rawId as string)
    if (parsed > 0) {
      taskId.value = parsed
      isEdit.value = true
      loadTask(parsed)
    }
  }
})
</script>

