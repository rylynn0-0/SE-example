  padding-bottom: 12rpx;
}

.hero-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.brand {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.brand-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background-color: #409eff;
  background-image: linear-gradient(135deg, #409eff 0%, #337ecc 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-logo-text {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
}

.brand-copy {
  display: flex;
  flex-direction: column;
  margin-left: 18rpx;
}

.brand-name {
  color: #303133;
  font-size: 32rpx;
  font-weight: 700;
}

.brand-sub {
  color: #909399;
  font-size: 17rpx;
  letter-spacing: 1rpx;
  margin-top: 4rpx;
}

.icon-button {
  width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
  background-color: #f5f7fa;
  border-width: 1px;
  border-style: solid;
  border-color: #ebeef5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-button-hover {
  background-color: #ecf5ff;
}

.icon-button-text {
  color: #606266;
  font-size: 32rpx;
}

.hero-title-wrap {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
}

.hero-eyebrow {
  color: #409eff;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  font-weight: 600;
}

.hero-title {
  color: #303133;
  font-size: 40rpx;
  line-height: 54rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.hero-desc {
  color: #909399;
  font-size: 22rpx;
  line-height: 32rpx;
  margin-top: 8rpx;
}

/* ---------- 统计卡片：与 Element Plus 卡片一致 ---------- */
.stats-row {
  display: flex;
  flex-direction: row;
  margin-top: 24rpx;
}

.stat-card {
  flex: 1;
  background-color: #ffffff;
  border-width: 1px;
  border-style: solid;
  border-color: #ebeef5;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-right: 12rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.stat-card:last-child {
  margin-right: 0;
}

.stat-label {
  color: #909399;
  font-size: 21rpx;
}

.stat-value {
  color: #303133;
  font-size: 40rpx;
  line-height: 52rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.stat-amber {
  color: #e6a23c;
}

.stat-green {
  color: #67c23a;
}

/* ---------- Redis 状态条 ---------- */
.cache-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top-width: 1px;
  border-top-style: solid;
  border-top-color: #ebeef5;
}

.cache-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}

.cache-dot-green {
  background-color: #67c23a;
}

.cache-dot-amber {
  background-color: #e6a23c;
}

.cache-text {
  color: #606266;
  font-size: 21rpx;
  flex: 1;
}

.cache-refresh {
  color: #409eff;
  font-size: 21rpx;
  font-weight: 600;
}

/* ---------- 主内容 ---------- */
.content {
  padding: 28rpx 32rpx 140rpx 32rpx;
}

.search-box {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 88rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  border-width: 1px;
  border-style: solid;
  border-color: #dcdfe6;
  padding-left: 24rpx;
  padding-right: 20rpx;
}

.search-icon {
  color: #909399;
  font-size: 34rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  height: 88rpx;
  color: #303133;
  font-size: 27rpx;
}

.search-placeholder {
  color: #c0c4cc;
}

.search-clear {
  color: #c0c4cc;
  font-size: 38rpx;
  padding-left: 16rpx;
  padding-right: 4rpx;
}

/* ---------- 筛选 ---------- */
.filter-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 22rpx;
}

.chip {
  height: 58rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  border-radius: 29rpx;
  background-color: #ffffff;
  border-width: 1px;
  border-style: solid;
  border-color: #dcdfe6;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.chip-active {
  background-color: #409eff;
  border-color: #409eff;
}

.chip-text {
  color: #606266;
  font-size: 23rpx;
  font-weight: 500;
}

.chip-active .chip-text {
  color: #ffffff;
}

.filter-count {
  flex: 1;
  align-items: flex-end;
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
}

.filter-count-text {
  color: #909399;
  font-size: 21rpx;
}

/* ---------- 状态 / 空列表 ---------- */
.state-box {
  margin-top: 32rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  border-width: 1px;
  border-style: solid;
  border-color: #ebeef5;
  padding: 64rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.spinner {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  border-width: 4rpx;
  border-style: solid;
  border-color: #e4e7ed;
  border-top-color: #409eff;
  margin-bottom: 20rpx;
}

.empty-mark {
  width: 92rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 46rpx;
  background-color: #ecf5ff;
  color: #409eff;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.state-title {
  color: #303133;
  font-size: 30rpx;
  font-weight: 600;
}

.state-text {
  color: #909399;
  font-size: 23rpx;
  line-height: 34rpx;
  margin-top: 8rpx;
  text-align: center;
}

.state-button {
  margin-top: 24rpx;
  height: 68rpx;
  padding-left: 30rpx;
  padding-right: 30rpx;
  border-radius: 8rpx;
  background-color: #409eff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.state-button-text {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

/* ---------- 任务卡片 ---------- */
.task-list {
  margin-top: 24rpx;
}

.task-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  border-width: 1px;
  border-style: solid;
  border-color: #ebeef5;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.task-card-done {
  background-color: #fafafa;
}

.task-main {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.check-button {
