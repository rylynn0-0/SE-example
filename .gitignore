node_modules/
dist/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 本地依赖缓存（体积大，只属于本机，不入库）----------
.m2-cache/
.m2/
.npm-cache/
.npm-logs/
.npm/
.gradle/
.yarn/
.pnpm-store/

